{
    "name": "admin-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "implicitDependencies": [
            "admin"
        ],
        "targets": {
            "catalog": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "apps/admin-e2e",
                    "command": "node tools/generate-test-catalog.mjs"
                }
            },
            "catalog:check": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [
                    "{projectRoot}/src/**/*.spec.ts",
                    "{projectRoot}/TESTS.md",
                    "{projectRoot}/tools/generate-test-catalog.mjs"
                ],
                "options": {
                    "cwd": "apps/admin-e2e",
                    "command": "node tools/generate-test-catalog.mjs --check"
                }
            }
        }
    }
}
