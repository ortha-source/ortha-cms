{
    "name": "@orthacms/server-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "server-e2e",
        "implicitDependencies": [
            "server"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "options": {
                    "jestConfig": "apps/server-e2e/jest.config.cts",
                    "passWithNoTests": true
                }
            },
            "catalog": {
                "executor": "nx:run-commands",
                "options": {
                    "cwd": "apps/server-e2e",
                    "command": "node tools/generate-test-catalog.mjs"
                }
            },
            "catalog:check": {
                "executor": "nx:run-commands",
                "cache": true,
                "inputs": [
                    "{projectRoot}/src/**/*.spec.ts",
                    "{projectRoot}/TESTS.md",
                    "{projectRoot}/tools/generate-test-catalog.mjs"
                ],
                "options": {
                    "cwd": "apps/server-e2e",
                    "command": "node tools/generate-test-catalog.mjs --check"
                }
            }
        }
    },
    "devDependencies": {
        "@orthacms/media-provider-memory": "*",
        "@testcontainers/postgresql": "^12.0.1",
        "@types/supertest": "^7.2.0",
        "sharp": "^0.33.5",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.1"
    }
}
