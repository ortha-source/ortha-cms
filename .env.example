# Port the API server listens on (defaults to 3000)
PORT=3000
# PostgreSQL connection string
DATABASE_URL=postgresql://ortha:ortha@localhost:5432/ortha_cms
# Serve the Scalar API reference on /reference (OpenAPI JSON on /reference/json).
# Unset, it is on outside production. Set true to publish it from a deployment.
API_DOCS=

# --- identity plugin ---
# Secret signing server-side session cookies (REQUIRED before auth lands — #8)
SESSION_SECRET=
# Secret signing one-time invite/reset tokens (REQUIRED before tokens land — #10)
TOKEN_SECRET=
# Optional lifetime overrides, in seconds
SESSION_TTL_SECONDS=604800
INVITE_TTL_SECONDS=604800
RESET_TTL_SECONDS=3600

# --- media plugin ---
# Storage provider the resolver falls back to (default: local filesystem).
MEDIA_PROVIDER=local
# Directory local blobs are written under. Git-ignored by default; point this at
# a persistent volume for a real deployment (a fresh container's disk is wiped).
MEDIA_LOCAL_ROOT=./.storage/media
# Max upload size in bytes (default 50 MB).
MEDIA_MAX_UPLOAD_BYTES=52428800
# S3 provider settings (only needed once the S3 adapter is wired in plugins.ts).
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=

# --- copilot plugin ---
# Global kill switch. OFF by default (ADR-0005 §10): enabling a hosted provider
# sends workspace content to a third party, so an operator opts in explicitly.
COPILOT_ENABLED=false
# Which registered provider serves a run: anthropic | local | fake.
# `fake` is scripted and needs no key and no network, so a fresh clone boots.
COPILOT_PROVIDER=fake
# Ceiling on a single model response, in tokens.
COPILOT_MAX_OUTPUT_TOKENS=8192
# Native Claude (COPILOT_PROVIDER=anthropic). The key never leaves the server.
ANTHROPIC_API_KEY=
COPILOT_ANTHROPIC_MODEL=claude-opus-5
# Optional: a gateway, proxy or regional endpoint instead of api.anthropic.com.
ANTHROPIC_BASE_URL=
# OpenAI-wire-format endpoint (COPILOT_PROVIDER=local). Defaults to a local
# Ollama; point it at vLLM, llama.cpp, LM Studio, LiteLLM, Azure or OpenAI.
COPILOT_OPENAI_BASE_URL=http://localhost:11434/v1
COPILOT_OPENAI_MODEL=llama3.1
# Leave empty for a local runtime that wants no auth.
COPILOT_OPENAI_API_KEY=

# --- root admin bootstrap (self-hosted) ---
# When ORTHA_ROOT_ADMIN_EMAIL is set, an active admin is provisioned on boot —
# idempotent and non-destructive (an existing account is left untouched).
# Leave the email unset to skip. The password is bcrypt-hashed before storage.
ORTHA_ROOT_ADMIN_EMAIL=
ORTHA_ROOT_ADMIN_PASSWORD=
