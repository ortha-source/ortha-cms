{
    "$schema": "../../node_modules/nx/schemas/executors-schema.json",
    "executors": {
        "db-generate": {
            "implementation": "./src/executors/db-generate/executor",
            "schema": "./src/executors/db-generate/schema.json",
            "description": "Generate Drizzle migrations for a plugin's schema."
        },
        "db-migrate": {
            "implementation": "./src/executors/db-migrate/executor",
            "schema": "./src/executors/db-migrate/schema.json",
            "description": "Apply every registered plugin's migrations."
        },
        "db-studio": {
            "implementation": "./src/executors/db-studio/executor",
            "schema": "./src/executors/db-studio/schema.json",
            "description": "Launch Drizzle Studio against the host database."
        }
    }
}
