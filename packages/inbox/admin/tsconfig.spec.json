{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/jest",
        "lib": ["es2022", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "tsBuildInfoFile": "./out-tsc/jest/tsconfig.spec.tsbuildinfo",
        "types": ["jest", "node"]
    },
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx",
        "src/**/*.d.ts"
    ],
    "references": [
        {
            "path": "./tsconfig.lib.json"
        }
    ]
}
