{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["es2022", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["dist", "**/*.spec.tsx", "**/*.test.tsx"],
    "references": [
        {
            "path": "../../identity/admin/tsconfig.lib.json"
        },
        {
            "path": "../../design-system/tsconfig.lib.json"
        },
        {
            "path": "../../bootstrap/admin/tsconfig.lib.json"
        }
    ]
}
