{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["es2022", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": [
        "dist",
        "out-tsc",
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.spec.tsx",
        "**/*.test.tsx",
        "vite.config.mts"
    ],
    "references": [
        {
            "path": "../../identity/admin/tsconfig.lib.json"
        },
        {
            "path": "../../design-system/tsconfig.lib.json"
        },
        {
            "path": "../../bootstrap/admin/tsconfig.lib.json"
        },
        {
            "path": "../../utils/admin/tsconfig.lib.json"
        }
    ]
}
