# Environment for __APP_TITLE__.
#
# Everything commented out is the default. `npx orthacms setup` fills this in
# for you and checks each value; `npx orthacms doctor` shows what is in
# effect. Clear the ORTHACMS_ROOT_ADMIN_* lines once you have signed in.
# Any variable can be read from a file instead: set NAME_FILE=/path/to/secret.

# --- Server ---
# The deployment mode. Required in production.
# NODE_ENV=production
# The port the server listens on.
# PORT=3000
# The address people open the admin on. Required in production.
# PUBLIC_URL=https://cms.example.com
# More origins allowed to sign in, comma-separated, when the admin is also
# served from another address.
# EXTRA_ORIGINS=https://admin.example.com
# The address browsers reach the API on, when it is not PUBLIC_URL.
# API_PUBLIC_URL=
# How many reverse proxies sit in front of the server. Required behind a load
# balancer, ingress or CDN.
# TRUST_PROXY=1
# Whether this process sends webhooks and mail.
# ORTHACMS_WORKERS=true

# --- Database ---
# The PostgreSQL connection string.
DATABASE_URL=__DATABASE_URL__

# --- First administrator ---
# An administrator to create on boot, when no account has this address.
ORTHACMS_ROOT_ADMIN_EMAIL=__ADMIN_EMAIL__
# That administrator's password. Hashed before it is stored.
ORTHACMS_ROOT_ADMIN_PASSWORD=__ADMIN_PASSWORD__
# That administrator's display name.
# ORTHACMS_ROOT_ADMIN_NAME=

# --- Uploads ---
# orthacms:if media-local
# The directory uploads are written to.
# MEDIA_LOCAL_ROOT=./.storage/media
# orthacms:end
# orthacms:if media-s3
# The S3 bucket uploads land in. Required with this backend.
# MEDIA_S3_BUCKET=
# orthacms:end
# orthacms:if media-s3
# The endpoint, for anything but AWS S3 itself: R2, MinIO, Spaces, B2, Wasabi.
# MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# orthacms:end
# orthacms:if media-s3
# The region. AWS needs its real one; R2 takes auto.
# MEDIA_S3_REGION=auto
# orthacms:end
# orthacms:if media-s3
# Path-style bucket addressing. MinIO needs it.
# MEDIA_S3_FORCE_PATH_STYLE=false
# orthacms:end
# orthacms:if media-s3
# The access key.
# MEDIA_S3_ACCESS_KEY_ID=
# orthacms:end
# orthacms:if media-s3
# The secret key.
# MEDIA_S3_SECRET_ACCESS_KEY=
# orthacms:end
# orthacms:if media-gcs
# The Cloud Storage bucket uploads land in. Required with this backend.
# MEDIA_GCS_BUCKET=
# orthacms:end
# orthacms:if media-gcs
# The project. Leave unset on GKE or Cloud Run, where Application Default
# Credentials apply.
# MEDIA_GCS_PROJECT_ID=
# orthacms:end
# orthacms:if media-gcs
# A service-account key file, when not using Application Default Credentials.
# MEDIA_GCS_KEY_FILE=
# orthacms:end
# orthacms:if media-gcs
# Sign URLs through IAM instead of a private key (Workload Identity).
# MEDIA_GCS_SIGN_WITH_IAM=false
# orthacms:end
# orthacms:if media-azure
# The blob container uploads land in. Required with this backend.
# MEDIA_AZURE_CONTAINER=media
# orthacms:end
# orthacms:if media-azure
# The storage account connection string. Required with this backend.
# MEDIA_AZURE_CONNECTION_STRING=
# orthacms:end
# orthacms:if media-vercel-blob
# The Vercel Blob token. Vercel sets it on its own platform; set it only
# elsewhere.
# BLOB_READ_WRITE_TOKEN=
# orthacms:end
# orthacms:if media-s3
# off streams every download through the server; signed-url redirects an
# authorised download to the storage backend.
# MEDIA_DIRECT_SERVE=off
# orthacms:end
# orthacms:if media-gcs
# off streams every download through the server; signed-url redirects an
# authorised download to the storage backend.
# MEDIA_DIRECT_SERVE=off
# orthacms:end
# orthacms:if media-azure
# off streams every download through the server; signed-url redirects an
# authorised download to the storage backend.
# MEDIA_DIRECT_SERVE=off
# orthacms:end

# --- Mail ---
# orthacms:if mail
# Where messages are handed off. Unset, the server sends nothing.
# MAIL_URL=smtp://user:password@smtp.example.com:587
# orthacms:end
# orthacms:if mail
# The sender. Required once MAIL_URL is set. Required with this backend.
# MAIL_FROM=Ortha CMS <no-reply@example.com>
# orthacms:end
# orthacms:if mail
# Where replies go, when not MAIL_FROM.
# MAIL_REPLY_TO=
# orthacms:end
# orthacms:if mail
# What the messages call the product.
# MAIL_PRODUCT_NAME=Ortha CMS
# orthacms:end
# orthacms:if mail
# Also return invite and reset links in API responses. For chasing a message
# that did not arrive; turn it off again.
# MAIL_REVEAL_LINKS=false
# orthacms:end

# --- Single sign-on ---
# orthacms:if sso-oidc
# The OpenID Connect issuer. With a client id, it is what turns the provider on.
# SSO_OIDC_ISSUER=https://example.okta.com
# orthacms:end
# orthacms:if sso-oidc
# The OpenID Connect client id.
# SSO_OIDC_CLIENT_ID=
# orthacms:end
# orthacms:if sso-oidc
# The client secret. Leave unset for a public client, which uses PKCE alone.
# SSO_OIDC_CLIENT_SECRET=
# orthacms:end
# orthacms:if sso-oidc
# Treat addresses as verified when the provider sends no email_verified claim.
# SSO_OIDC_EMAIL_VERIFIED_WHEN_ABSENT=false
# orthacms:end
# orthacms:if sso-github
# The GitHub OAuth app client id.
# SSO_GITHUB_CLIENT_ID=
# orthacms:end
# orthacms:if sso-github
# The client secret. Required: GitHub has no PKCE, so it is what proves the code
# is redeemed by this app.
# SSO_GITHUB_CLIENT_SECRET=
# orthacms:end
# orthacms:if sso-github
# A GitHub Enterprise Server root. Unset for github.com.
# SSO_GITHUB_ENTERPRISE_URL=https://github.example.com
# orthacms:end
# orthacms:if sso-saml
# The identity provider's single sign-on URL. With the certificate, it is what
# turns SAML on.
# SSO_SAML_ENTRY_POINT=
# orthacms:end
# orthacms:if sso-saml
# The identity provider's signing certificate, PEM or base64.
# SSO_SAML_IDP_CERT=
# orthacms:end
# orthacms:if sso-saml
# The entity id the identity provider registered for this app. Defaults to
# API_PUBLIC_URL, then PUBLIC_URL.
# SSO_SAML_ISSUER=
# orthacms:end
# orthacms:if sso-saml
# The attribute holding a stable id for the person. Set it whenever the NameID
# is an email address.
# SSO_SAML_SUBJECT_ATTRIBUTE=
# orthacms:end
# orthacms:if sso-saml
# Treat addresses from the identity provider as verified.
# SSO_SAML_EMAIL_VERIFIED=false
# orthacms:end
# orthacms:if sso
# Email domains an account may be created for on first sign-in. Unset, SSO signs
# in existing accounts only.
# SSO_PROVISION_DOMAINS=example.com
# orthacms:end
# orthacms:if sso
# The role a provisioned account starts with.
# SSO_PROVISION_ROLE=viewer
# orthacms:end
# orthacms:if sso
# Set false to make single sign-on the only way in. The root administrator keeps
# a password regardless.
# SSO_ALLOW_PASSWORD_LOGIN=true
# orthacms:end

# --- Copilot ---
# Offer the copilot at all.
COPILOT_ENABLED=false
# orthacms:if copilot-anthropic
# The Anthropic API key. Setting it is what registers Claude.
# ANTHROPIC_API_KEY=
# orthacms:end
# orthacms:if copilot-anthropic
# A gateway or proxy to use instead of api.anthropic.com.
# ANTHROPIC_BASE_URL=
# orthacms:end
# orthacms:if copilot-anthropic
# The Claude models people may pick, comma-separated. The first is the default.
# COPILOT_ANTHROPIC_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
# orthacms:end
# orthacms:if copilot-openai
# An OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, LiteLLM, Azure or
# OpenAI. Setting it registers the backend.
# COPILOT_OPENAI_BASE_URL=http://localhost:11434/v1
# orthacms:end
# orthacms:if copilot-openai
# That endpoint's key. Unset for a local runtime.
# COPILOT_OPENAI_API_KEY=
# orthacms:end
# orthacms:if copilot-openai
# The models people may pick there. The first is the default.
# COPILOT_OPENAI_MODELS=llama3.1
# orthacms:end
# Tokens one person may spend in one workspace per day (UTC). Unset is
# unlimited.
# COPILOT_USER_DAILY_TOKENS=
# Tokens all members of one workspace may spend per day (UTC). Unset is
# unlimited.
# COPILOT_WORKSPACE_DAILY_TOKENS=
# Runs one person may start per minute. Unset is unlimited.
# COPILOT_RUNS_PER_MINUTE=
# Runs one person may have in flight at once. Unset is unlimited.
# COPILOT_MAX_CONCURRENT_RUNS=

# --- Switches ---
# Publish the API reference on /reference and GraphiQL. On outside production
# unless set.
# API_DOCS=
# orthacms:if mcp
# Serve the Model Context Protocol endpoint on /api/v1/mcp.
MCP_ENABLED=false
# orthacms:end
# Allow http:// webhook destinations. For local development: the payload is
# readable on the way.
# WEBHOOKS_ALLOW_INSECURE_URLS=false
# Allow webhook destinations on loopback, link-local and private networks.
# WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false

# --- Development only ---
# Let the Content model page edit types. It writes code, so it is refused in
# production whatever this says.
# SCHEMA_BUILDER=false
# The server app's folder, relative to where the server is started.
# SCHEMA_BUILDER_ROOT=apps/server
# watch waits for the dev watcher to restart the server after an edit; manual
# asks you to.
# SCHEMA_BUILDER_RESTART=watch
# The port the admin dev server listens on.
# ADMIN_PORT=4200
