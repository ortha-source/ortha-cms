{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "**/*.spec.ts", "**/*.test.ts"],
    "references": [
        { "path": "../domain/tsconfig.lib.json" },
        { "path": "../provider-anthropic/tsconfig.lib.json" },
        { "path": "../provider-openai-compatible/tsconfig.lib.json" },
        { "path": "../../bootstrap/server/tsconfig.lib.json" }
    ]
}
