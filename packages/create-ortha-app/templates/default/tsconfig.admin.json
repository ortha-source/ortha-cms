{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2023",
            "dom",
            "dom.iterable"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": [
            "node",
            "vite/client"
        ],
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "src/admin/**/*.ts",
        "src/admin/**/*.tsx",
        "e2e/**/*.ts",
        "vite.config.mts",
        "playwright.config.ts"
    ]
}
