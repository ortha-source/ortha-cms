{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/vitest",
        "lib": [
            "es2022",
            "dom",
            "dom.iterable"
        ],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "tsBuildInfoFile": "./out-tsc/vitest/tsconfig.spec.tsbuildinfo",
        "types": [
            "vitest/globals",
            "vitest/importMeta",
            "vite/client",
            "node",
            "vitest"
        ]
    },
    "include": [
        "vite.config.mts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx",
        "src/**/*.d.ts"
    ],
    "references": [
        {
            "path": "./tsconfig.lib.json"
        }
    ]
}
