{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/jest",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "tsBuildInfoFile": "./out-tsc/jest/tsconfig.spec.tsbuildinfo",
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.d.ts"
    ],
    "references": [
        {
            "path": "./tsconfig.lib.json"
        }
    ]
}
